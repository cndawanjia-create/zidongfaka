{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cffk",
	"compatibility_date": "2026-03-12",
	"keep_vars": true,
	"main": "vike:server-entry",
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cffk_db",
			"migrations_dir": "database/migrations",
			"database_id": "aef02f5b-39f8-4941-ade6-05ae45c7ccb2"
		}
	],
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	}
}
